---
import '../styles/global.css';
import '../styles/studio.css';
import {navigation} from '../data/chords.js';
const {title='Piano Chord Explorer',description='Learn piano chords through clear notes, interactive keyboards, inversions, and original printable diagrams.',canonicalPath=Astro.url.pathname,crumbs=[],noindex=false}=Astro.props;
const canonical=new URL(canonicalPath,Astro.site || Astro.url).toString();
const siteName='Piano Chord Explorer';
const shareImage=new URL('/share-card.png',Astro.site || Astro.url).toString();
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Piano Chord Explorer — piano keys and free music learning tools" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <title>{title}</title>
    {Astro.url.pathname==='/' && <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org',
      '@type':'WebSite',
      name:siteName,
      url:new URL('/',Astro.site || Astro.url).toString(),
      inLanguage:'en'
    })} />}
    {crumbs.length>0 && <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'Home',item:new URL('/',Astro.site||Astro.url).toString()},...crumbs.map((x,i)=>({'@type':'ListItem',position:i+2,name:x.name,item:new URL(x.href,Astro.site||Astro.url).toString()}))]})} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="topnote"><div class="container topnote-inner"><span>PLAY · LISTEN · DISCOVER</span><span>88 piano keys · 120 chords · Free</span></div></div>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Piano Chord Explorer home">
          <span class="brand-mark" aria-hidden="true"><span>♩</span></span>
          <span class="brand-type">Piano Chord <strong>Explorer<span class="brand-dot">.</span></strong></span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map((n)=><a href={n.href} class={Astro.url.pathname===n.href?'nav-active':''}>{n.label}</a>)}
        </nav>
        <a class="header-action" href="/chords/">Explore chords <span aria-hidden="true">↗</span></a>
        <details class="mobile-nav"><summary aria-label="Open menu">Menu ☰</summary><nav aria-label="Mobile navigation">{navigation.map((n)=><a href={n.href}>{n.label}</a>)}</nav></details>
      </div>
    </header>
    <main id="main">
      {crumbs.length>0 && <div class="container crumb-wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{crumbs.map(x=><><span aria-hidden="true">/</span><a href={x.href}>{x.name}</a></>)}</nav></div>}
      <slot/>
    </main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div><a href="/" class="brand footer-brand"><span class="brand-mark" aria-hidden="true">♩</span><span class="brand-type">Piano Chord <strong>Explorer.</strong></span></a><p>Understand the notes. Hear the harmony.<br/>Practice one chord at a time.</p></div>
        <div class="footer-col"><strong>Explore</strong><a href="/chords/">All chords</a><a href="/tools/chord-finder/">Chord finder</a><a href="/tools/virtual-piano/">Virtual piano</a><a href="/tools/chord-library/">120 chord atlas</a><a href="/tools/chord-compare/">Compare chords</a><a href="/tools/scales-and-keys/">Scales &amp; Keys</a><a href="/tools/chord-progressions/">Progression trainer</a><a href="/tools/metronome/">Metronome</a></div>
        <div class="footer-col"><strong>Learn</strong><a href="/guides/how-to-read-piano-chords/">Reading chord diagrams</a><a href="/guides/seventh-chords-piano/">Seventh chord types</a><a href="/tools/inversion-explorer/">Chord inversions</a><a href="/printables/piano-chord-chart/">Printable chart</a><a href="/open-source/">Open-source notices</a><a href="/about/">About &amp; feedback</a><a href="/privacy/">Privacy</a><a href="mailto:contact@pianochordexplorer.com">Contact</a></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} Piano Chord Explorer. Original diagrams and explanations.</span><span>Music examples use 12-tone equal temperament.</span></div>
    </footer>
    <div class="visually-hidden" role="status" aria-live="polite" id="app-status"></div>
    <script>
      // The virtual piano runs its own UI. Avoid loading the chord atlas/finder
      // shared client bundle for this already JS-heavy page.
      if (window.location.pathname !== '/tools/virtual-piano/') {
        import('../scripts/client.js');
      }
    </script>
  </body>
</html>

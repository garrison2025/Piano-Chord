---
import BaseLayout from '../layouts/BaseLayout.astro';
import PianoKeyboard from '../components/PianoKeyboard.astro';
import ChordCard from '../components/ChordCard.astro';
import {releaseChords} from '../data/chords.js';
import {createChord,prettyNote} from '../lib/music.js';
const picks=['b-minor','c-major','c-7'].map(slug=>createChord(releaseChords.find(e=>e.slug===slug)));
const spotlightNames=['B minor','C major','C seventh'];
---
<BaseLayout title="Learn Piano Chords Visually | Piano Chord Explorer" description="Play a free 88-key piano, explore 120 chords and 24 major/minor scales, practise progressions and record shareable performances. No signup." canonicalPath="/">
  <section class="hero studio-hero">
    <div class="hero-orb hero-orb-a" aria-hidden="true"></div><div class="hero-orb hero-orb-b" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow hero-eyebrow"><span class="status-dot" aria-hidden="true"></span> YOUR FREE PIANO CHORD STUDIO</span>
        <h1>Piano chords,<br/><em>made musical.</em></h1>
        <p class="hero-description">See every note. Hear every change. Learn the shapes that make music click — one chord at a time.</p>
        <div class="button-row hero-buttons">
          <a class="btn btn-primary btn-large" href="/chords/">Explore the chord library <span class="action-arrow" aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost btn-large" href="/tools/chord-finder/"><span aria-hidden="true">⌕</span> Find a chord</a>
        </div>
        <div class="hero-trust"><span><span aria-hidden="true">✦</span> Completely free</span><span>No account needed</span><span>Learn at your own pace</span></div>
        <div class="stat-strip"><div class="stat"><strong>29</strong><span>Chord lessons</span></div><div class="stat"><strong>08</strong><span>Interactive tools</span></div><div class="stat"><strong>∞</strong><span>Moments to explore</span></div></div>
      </div>
      <div class="studio-wrap">
        <div class="studio-floating studio-floating-top" aria-hidden="true">♫</div>
        <div class="demo-window studio-player" data-spotlight>
          <div class="demo-top"><span class="studio-label"><span class="live-pulse" aria-hidden="true"></span> INTERACTIVE CHORD STUDIO</span><div class="demo-dots" aria-hidden="true"><i></i><i></i><i></i></div></div>
          <div class="studio-heading"><div><span class="studio-kicker">Learn by listening</span><h2>Hear the harmony<span>.</span></h2></div><span class="studio-disc" aria-hidden="true">♫</span></div>
          <div class="studio-tabs" role="group" aria-label="Choose a chord to preview">
            {picks.map((chord,i)=><button type="button" data-spotlight-choice={i} class:list={['studio-tab',i===0&&'is-active']} aria-pressed={i===0?'true':'false'}>{chord.symbol.replaceAll('b','♭')}</button>)}
          </div>
          {picks.map((chord,i)=><div class="studio-chord" data-spotlight-view={i} hidden={i!==0}>
            <div class="studio-chord-top"><div><span class="studio-quiet">NOW EXPLORING</span><h3>{chord.name}</h3></div><span class="studio-quality">{chord.qualityName}</span></div>
            <div class="studio-notes">{chord.notes.map((note,index)=><span class="studio-note" style={`--note-delay:${index*70}ms`}>{prettyNote(note)}</span>)}</div>
            <div class="studio-keyboard"><PianoKeyboard chord={chord}/></div>
            <div class="studio-player-actions"><button class="btn studio-play" type="button" data-play-midi={chord.inversions[0].midi.join(',')} aria-label={`Play ${chord.name} chord`}><span class="play-symbol" aria-hidden="true">▶</span> Play chord <span class="audio-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span></button><a href={`/chords/${chord.slug}/`} class="studio-learn">Learn this chord <span aria-hidden="true">↗</span></a></div>
          </div>)}
          <div class="studio-foot"><span aria-hidden="true">✳</span> Tap a chord above to hear a different sound</div>
        </div>
        <div class="studio-floating studio-floating-bottom" aria-hidden="true">✦</div>
      </div>
    </div>
  </section>
  <section class="section chords-showcase"><div class="container"><div class="section-head"><div><span class="eyebrow">01 / THE CHORD LIBRARY</span><h2>A little theory.<br/><span class="accent-heading">A lot of possibility.</span></h2><p>Explore familiar shapes, discover their notes and hear how each harmony comes alive.</p></div><a class="text-link" href="/chords/">See all 29 chords <span aria-hidden="true">↗</span></a></div><div class="card-grid">{releaseChords.slice(0,8).map((e,i)=><div class="reveal-on-scroll" style={`--reveal-delay:${Math.min(i%4,3)*65}ms`}><ChordCard entry={e}/></div>)}</div></div></section>
  <section class="section"><div class="container"><div class="cta-band"><div><span class="eyebrow">NEW / PLAY & LEARN</span><h2>88 piano keys. 120 core chords.</h2><p>Play a complete virtual keyboard using your computer, mouse or touch—then discover the notes behind each chord.</p></div><div><a class="btn" href="/tools/virtual-piano/">Play virtual piano ↗</a><a class="btn" href="/tools/chord-library/">Explore 120 chords ↗</a></div></div></div></section><section class="section tools-showcase"><div class="container"><div class="section-head"><div><span class="eyebrow">02 / PLAY & DISCOVER</span><h2>Music makes more<br/><span class="accent-heading">sense when you play.</span></h2><p>Simple tools that take you from “which keys?” to “now I get it.”</p></div></div>
    <div class="feature-grid">
      <a class="feature-card reveal-on-scroll" href="/tools/chord-finder/"><span class="feature-num">01 / DISCOVER</span><div class="feature-icon" aria-hidden="true">⌕</div><h3>Chord finder</h3><p>Tap the notes you know. Discover which chords they make.</p><span class="feature-cta">Find my chord <span aria-hidden="true">↗</span></span></a>
      <a class="feature-card reveal-on-scroll" style="--reveal-delay:80ms" href="/tools/inversion-explorer/"><span class="feature-num">02 / LISTEN</span><div class="feature-icon" aria-hidden="true">♬</div><h3>Inversion explorer</h3><p>Same notes, new feeling. Hear how moving one note changes everything.</p><span class="feature-cta">Try inversions <span aria-hidden="true">↗</span></span></a>
      <a class="feature-card reveal-on-scroll" style="--reveal-delay:160ms" href="/tools/chord-compare/"><span class="feature-num">03 / UNDERSTAND</span><div class="feature-icon" aria-hidden="true">⇄</div><h3>Chord comparison</h3><p>Two chords, side by side. See what stays and what moves.</p><span class="feature-cta">Compare chords <span aria-hidden="true">↗</span></span></a>
    </div></div></section>
  <section class="section tools-showcase"><div class="container"><div class="section-head"><div><span class="eyebrow">03 / BUILD YOUR SKILLS</span><h2>From a single note<br/><span class="accent-heading">to a song.</span></h2><p>Learn the notes in a key, practise four-chord changes, and keep the beat while you play.</p></div></div>
    <div class="feature-grid">
      <a class="feature-card reveal-on-scroll" href="/tools/scales-and-keys/"><span class="feature-num">01 / LEARN</span><div class="feature-icon" aria-hidden="true">♮</div><h3>Scales &amp; Keys</h3><p>Explore all 12 major and 12 natural minor scales with the diatonic chords in each key.</p><span class="feature-cta">Explore all scales ↗</span></a>
      <a class="feature-card reveal-on-scroll" href="/tools/chord-progressions/"><span class="feature-num">02 / PLAY</span><div class="feature-icon" aria-hidden="true">♫</div><h3>Chord progressions</h3><p>Hear and edit four-bar loops with your choice of key, tempo and rhythmic accents.</p><span class="feature-cta">Build a progression ↗</span></a>
      <a class="feature-card reveal-on-scroll" href="/tools/metronome/"><span class="feature-num">03 / PRACTISE</span><div class="feature-icon" aria-hidden="true">♩</div><h3>Metronome</h3><p>Keep time with an accurate browser metronome, adjustable BPM and tap tempo.</p><span class="feature-cta">Start a steady beat ↗</span></a>
    </div></div></section>
  <section class="section print-section"><div class="container"><div class="cta-band"><div class="cta-copy"><span class="eyebrow">03 / TAKE IT OFFLINE</span><h2>Make room for<br/>a little practice.</h2><p>Bring 16 beautifully clear chord diagrams to your music stand. No account, no fuss.</p><a class="btn btn-light btn-large" href="/printables/piano-chord-chart/">Get the printable chart <span aria-hidden="true">↗</span></a></div><div class="cta-sheet" aria-hidden="true"><div class="sheet-top"><span>Piano Chord Explorer</span><span>CHORD SHEET / 01</span></div><div class="sheet-title">The essentials.</div><div class="sheet-chords"><span>C</span><span>Dm</span><span>Em</span><span>F</span><span>G</span><span>Am</span></div><div class="sheet-keys">{Array.from({length:13},(_,i)=><i class={i===0||i===3||i===7?'selected':''}></i>)}</div><div class="sheet-footer">Learn it. Play it. Love it.</div></div></div></div></section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PianoKeyboard from '../../components/PianoKeyboard.astro';
import ChordCard from '../../components/ChordCard.astro';
import {releaseChords} from '../../data/chords.js';
import {chordLessons} from '../../data/editorials.js';
import {createChord,prettyNote} from '../../lib/music.js';
import {relatedLessons} from '../../lib/chordRelations.mjs';
export function getStaticPaths(){return releaseChords.map(entry=>({params:{slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
const chord=createChord(entry);
const lesson=chordLessons[entry.slug];
const related=relatedLessons(entry);
const spelled=chord.notes.map(prettyNote).join(' – ');
const qualityTip={major:'A major triad contains a root, major third (4 semitones) and perfect fifth (7 semitones).',minor:'A minor triad contains a root, minor third (3 semitones) and perfect fifth (7 semitones).',dominant7:'A dominant seventh contains root (0), major third (4), perfect fifth (7) and minor seventh (10 semitones).',major7:'A major seventh contains root (0), major third (4), perfect fifth (7) and major seventh (11 semitones).',minor7:'A minor seventh contains root (0), minor third (3), perfect fifth (7) and minor seventh (10 semitones).'}[chord.quality];
const thirdKind=['minor','minor7'].includes(chord.quality)?'minor':'major';
const seventhKind=chord.quality==='major7'?'major seventh':'minor seventh';
const description=`Learn the ${chord.name} piano chord (${prettyNote(chord.symbol)}): notes ${spelled}, keyboard diagram, audio, root position and ${chord.inversions.length-1} inversions.`;
const heading=`${chord.name} piano chord`;
const invNames=['Root position','First inversion','Second inversion','Third inversion'];
---
<BaseLayout title={`${heading} – Notes, Keyboard & Inversions | Piano Chord Explorer`} description={description} canonicalPath={`/chords/${entry.slug}/`} crumbs={[{name:'Chord Library',href:'/chords/'},{name:chord.name,href:`/chords/${entry.slug}/`}] }>
  <div class="container page-hero lesson-hero"><span class="eyebrow">THE CHORD ATLAS / {chord.qualityName.toUpperCase()}</span><h1>{heading}</h1><p class="lead">The <strong>{prettyNote(chord.symbol)}</strong> chord is built from <strong>{spelled}</strong>. See the exact keys, hear how they sound together, and explore how the chord changes when you move its lowest note.</p><div class="lesson-facts"><span><b>{chord.notes.length}</b> notes</span><span><b>{chord.inversions.length}</b> voicings</span><span><b>Free</b> to play &amp; print</span></div><nav class="lesson-jumps no-print" aria-label="On this page"><a href="#listen">01 <span>Listen</span> ↘</a><a href="#inversions">02 <span>Inversions</span> ↘</a><a href="#practice">03 <span>Practice</span> ↘</a></nav></div>
  <section id="listen" class="container section-compact lesson-listen"><div class="two-col">
    <article class="panel"><div style="display:flex;justify-content:space-between;align-items:start;gap:15px;flex-wrap:wrap"><div><span class="tag">Interactive keyboard</span><h2 style="margin:13px 0 7px">{prettyNote(chord.symbol)} <span style="color:#7b8d84;font-size:17px">{chord.qualityName}</span></h2><p>Selected notes: <strong>{spelled}</strong></p></div><span class="help-text">12-tone equal temperament</span></div>
      <img class="keyboard-image" src={`/diagrams/${entry.slug}.svg`} alt={`${chord.name} keyboard diagram showing ${spelled}`} width="692" height="195" decoding="async"/>
      <div class="button-row no-print" style="margin-bottom:0"><button class="btn btn-primary" type="button" data-play-midi={chord.inversions[0].midi.join(',')}>▶ Play {prettyNote(chord.symbol)}</button><button class="btn" type="button" data-stop-audio>■ Stop</button><a class="btn" href={`/diagrams/${entry.slug}.svg`} download={`${entry.slug}-piano-keyboard.svg`}>↓ Save SVG</a></div>
    </article>
    <aside class="panel"><span class="eyebrow">The essentials</span><h2 style="margin:12px 0">What's inside?</h2><div class="note-row" style="margin:17px 0">{chord.notes.map(note=><span class="note-pill" style="font-size:18px;padding:7px 13px">{prettyNote(note)}</span>)}</div><div class="note-explainer"><h3>How it is built</h3><p>{qualityTip}</p></div><p style="font-size:14px;margin-top:16px">Spell each note as written above. For example, F♯ and G♭ use the same piano key in this tuning system but can have different harmonic meanings.</p></aside>
  </div></section>
  <section id="inversions" class="container section-compact lesson-inversions"><div class="section-head"><div><span class="eyebrow">Change the bass</span><h2>Explore the inversions</h2><p>All inversions use the same pitch classes. Moving the bottom note up an octave changes the voicing, not the chord identity.</p></div><a href="/tools/inversion-explorer/" class="text-link">Full inversion explorer ↗</a></div>
    <div class="panel inversion-panel" data-inversion-panel><div class="inline-actions inversion-tabs no-print" role="group" aria-label="Choose chord inversion">{chord.inversions.map((v,i)=><button class:list={['btn',i===0&&'btn-primary']} data-inversion-button={i} aria-pressed={i===0?'true':'false'} type="button">{invNames[i]}</button>)}</div>
      {chord.inversions.map((v,i)=><div class="inversion-view" data-inversion-view={i} hidden={i!==0}><h3 style="margin:21px 0 4px">{invNames[i]}: {v.notes.map(prettyNote).join(' · ')}</h3><p>Lowest note: <strong>{prettyNote(v.bass)}</strong>. Each higher note is placed above the previous one.</p><PianoKeyboard chord={chord} inversion={i}/><div class="button-row no-print" style="margin-bottom:0"><button class="btn btn-primary" type="button" data-play-midi={v.midi.join(',')}>▶ Hear this voicing</button></div></div>)}
    </div>
  </section>
  <section id="practice" class="container section-compact lesson-practice"><div class="two-col"><article class="prose"><span class="eyebrow">Learn the shape</span><h2>How to play {prettyNote(chord.symbol)} on piano</h2><p>First, find <strong>{prettyNote(chord.root)}</strong>, the root of this chord. Then add <strong>{prettyNote(chord.notes[1])}</strong>, the {thirdKind} third. Add <strong>{prettyNote(chord.notes[2])}</strong> to complete the triad. {chord.notes.length===4?`The fourth note, ${prettyNote(chord.notes[3])}, is a ${seventhKind} above the root.`:''}</p><p>Play the notes together to hear the harmony, or one at a time to hear how the intervals form the chord. Start at a comfortable octave; the diagram shows one reference voicing, not the only valid place to play it.</p><h3>What makes {prettyNote(chord.symbol)} distinctive?</h3><p>{lesson.character}</p><h3>Compare this chord with another</h3><p>{lesson.comparison}</p><h3>A practice exercise for {prettyNote(chord.symbol)}</h3><p>{lesson.exercise}</p><h3>One mistake to avoid</h3><p>{lesson.pitfall}</p><h3>A simple practice routine</h3><ul><li>Say each note name aloud as you find its key.</li><li>Play the root-position chord, then release the keys evenly.</li><li>Move to first inversion and listen to the bass change.</li><li>Return to root position without looking at the diagram.</li></ul><p>Finger numbers depend on your hand size, octave and musical context; there isn't one universally correct fingering for every voicing.</p></article>
      <aside class="panel"><h3>Practice beyond this chord</h3><p>Compare the notes with another harmony, or keep a printed reference on your music stand.</p><div style="display:grid;gap:10px"><a class="btn" href={`/tools/chord-compare/?a=${encodeURIComponent(entry.slug)}`}>⇄ Compare this chord</a><a class="btn" href="/printables/piano-chord-chart/">↓ Printable chord chart</a><a class="btn" href="/guides/how-to-read-piano-chords/">↗ Read chord diagrams</a>{chord.notes.length===4&&<a class="btn" href="/guides/seventh-chords-piano/">♬ Compare seventh chords</a>}</div></aside></div>
  </section>
  <section class="container section-compact"><div class="section-head"><div><span class="eyebrow">Keep exploring</span><h2>Related piano chords</h2></div></div><div class="card-grid">{related.map(e=><ChordCard entry={e}/>)}</div></section>
</BaseLayout>

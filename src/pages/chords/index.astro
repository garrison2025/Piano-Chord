---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChordCard from '../../components/ChordCard.astro';
import {releaseChords} from '../../data/chords.js';
const majors=releaseChords.filter(x=>x.quality==='major');const minors=releaseChords.filter(x=>x.quality==='minor');const sevenths=releaseChords.filter(x=>x.quality==='dominant7');
---
<BaseLayout title="Piano Chord Library: Major, Minor & 7th Chords" description="Browse 16 free piano chord lessons. View correct note names, original keyboard diagrams, playable sounds and chord inversions." canonicalPath="/chords/" crumbs={[{name:'Chord Library',href:'/chords/'}]}>
  <section class="page-hero"><div class="container"><span class="eyebrow">Free chord reference</span><h1>Every chord starts<br/>with a few notes.</h1><p class="lead">Search our first 16 reviewed piano chords. Click one to hear it, see the keys and learn its inversions. More chords can be explored inside the tools without creating dozens of duplicate SEO pages.</p><div class="search-bar no-print"><input class="field" type="search" id="chord-search" placeholder="Search chords, e.g. Bm, E-flat, C7" aria-label="Filter chord library"/></div></div></section>
  <div class="container section-compact" id="chord-library">
    <section class="chord-group" data-group><div class="section-head"><div><h2>Major chords</h2><p>Bright, stable three-note harmonies: root, major third and perfect fifth.</p></div></div><div class="card-grid">{majors.map(e=><div data-searchable-chord={`${e.name} ${e.symbol} ${e.root}`}><ChordCard entry={e}/></div>)}</div></section>
    <section class="chord-group section" data-group><div class="section-head"><div><h2>Minor chords</h2><p>Minor thirds create a darker color, while the perfect fifth stays the same.</p></div></div><div class="card-grid">{minors.map(e=><div data-searchable-chord={`${e.name} ${e.symbol} ${e.root}`}><ChordCard entry={e}/></div>)}</div></section>
    <section class="chord-group section-compact" data-group><div class="section-head"><div><h2>Dominant seventh</h2><p>Four notes and a characteristic pull toward resolution.</p></div></div><div class="card-grid">{sevenths.map(e=><div data-searchable-chord={`${e.name} ${e.symbol} ${e.root}`}><ChordCard entry={e}/></div>)}</div></section>
    <div id="no-chord-matches" class="empty-msg" hidden>No published chord page matched. Try the <a class="text-link" href="/tools/chord-finder/">chord finder</a> for other note combinations.</div>
  </div>
</BaseLayout>

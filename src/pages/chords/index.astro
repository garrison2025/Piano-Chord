---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChordCard from '../../components/ChordCard.astro';
import {releaseChords} from '../../data/chords.js';
const majors=releaseChords.filter(x=>x.quality==='major');const minors=releaseChords.filter(x=>x.quality==='minor');const sevenths=releaseChords.filter(x=>x.quality==='dominant7');
---
<BaseLayout title="Piano Chord Library: Major, Minor & 7th Chords" description="Browse 25 original piano chord lessons: all 12 major, all 12 minor, and C7. View correct note names, original keyboard diagrams, playable sounds and chord inversions." canonicalPath="/chords/" crumbs={[{name:'Chord Library',href:'/chords/'}]}>
  <section class="page-hero library-hero"><div class="container"><span class="eyebrow">THE CHORD ATLAS / 25 EXPLORED</span><h1>Find your<br/><em>next harmony.</em></h1><p class="lead">Twenty-five individually written piano chord lessons covering all twelve major and twelve minor triads, plus C7. Search by name, or browse major, minor and dominant seventh sounds. Every lesson includes playable notes and clear inversion diagrams.</p><div class="library-filters no-print"><div class="search-bar"><input class="field" type="search" id="chord-search" placeholder="Search: Bm, C7, E-flat…" aria-label="Filter chord library" autocomplete="off"/><button id="clear-chord-search" class="search-clear" type="button" aria-label="Clear search" hidden>×</button></div><div class="filter-chips" role="group" aria-label="Filter chord type"><button class="filter-chip is-selected" type="button" data-quality-filter="all" aria-pressed="true">All chords</button><button class="filter-chip" type="button" data-quality-filter="major" aria-pressed="false">Major</button><button class="filter-chip" type="button" data-quality-filter="minor" aria-pressed="false">Minor</button><button class="filter-chip" type="button" data-quality-filter="dominant7" aria-pressed="false">Seventh</button></div><p class="filter-count" id="chord-result-count" role="status" aria-live="polite">Showing all 25 chords</p></div></div></section>
  <div class="container section-compact" id="chord-library">
    <section class="chord-group" data-group="major"><div class="section-head"><div><h2>Major chords</h2><p>Bright, stable three-note harmonies: root, major third and perfect fifth.</p></div></div><div class="card-grid">{majors.map(e=><div data-searchable-chord={`${e.name} ${e.symbol} ${e.root}`}><ChordCard entry={e}/></div>)}</div></section>
    <section class="chord-group section" data-group="minor"><div class="section-head"><div><h2>Minor chords</h2><p>Minor thirds create a darker color, while the perfect fifth stays the same.</p></div></div><div class="card-grid">{minors.map(e=><div data-searchable-chord={`${e.name} ${e.symbol} ${e.root}`}><ChordCard entry={e}/></div>)}</div></section>
    <section class="chord-group section-compact" data-group="dominant7"><div class="section-head"><div><h2>Dominant seventh</h2><p>Four notes and a characteristic pull toward resolution.</p></div></div><div class="card-grid">{sevenths.map(e=><div data-searchable-chord={`${e.name} ${e.symbol} ${e.root}`}><ChordCard entry={e}/></div>)}</div></section>
    <div id="no-chord-matches" class="empty-msg library-empty" hidden><span class="empty-icon" aria-hidden="true">♫</span><h3>No matching chords yet</h3><p>Try another name or reset the filters. You can explore other note combinations in our <a class="text-link" href="/tools/chord-finder/">chord finder</a>.</p><button class="btn btn-primary" type="button" id="reset-chord-filters">Show all chords</button></div>
  </div>
<section class="container section"><div class="panel"><h2>Explore beyond 25 lessons</h2><p>The 25 written lessons cover the full chromatic major/minor triad set, plus C7. Browse and play 120 core chord combinations in the interactive library, without generating hundreds of thin SEO pages.</p><a class="btn btn-primary" href="/tools/chord-library/">Open 120 chord atlas ↗</a></div></section></BaseLayout>

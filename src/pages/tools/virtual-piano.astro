---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/recording.css';
import '../../styles/learning.css';
import MetronomePanel from '../../components/MetronomePanel.astro';
const names=['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
const black=new Set([1,3,6,8,10]);
let whiteIndex=0;
const keys=Array.from({length:88},(_,i)=>{const midi=i+21;const b=black.has(midi%12);const k={midi,black:b,note:names[midi%12]+(Math.floor(midi/12)-1),left:b?whiteIndex*42-13:whiteIndex*42};if(!b)whiteIndex++;return k;});
---
<BaseLayout title="Virtual Piano – Play, Record & Share 88 Keys Online" description="Play and record an 88-key online piano. Replay your performance, export MIDI and make vertical videos to share on TikTok, X or Shorts — free in your browser." canonicalPath="/tools/virtual-piano/" crumbs={[{name:'Virtual Piano',href:'/tools/virtual-piano/'}]}>
<section class="container page-hero"><span class="eyebrow">THE PLAYABLE PIANO</span><h1>88 keys.<br/><em>Unlimited expression.</em></h1><p class="lead">Play an entire A0–C8 piano from your browser. Use your computer keyboard, mouse or touchscreen—no account required.</p><div class="button-row"><a class="btn btn-primary" href="/tools/chord-library/">Browse 120 chords ↗</a><a class="btn" href="/chords/">Chord lessons</a><a class="btn" href="#recording-studio">Record &amp; share ↗</a></div></section>
<section class="container section-compact" id="piano-practice" hidden>
 <div class="learning-panel practice-guide">
  <div class="practice-heading"><div><span class="eyebrow" id="practice-kicker">YOUR FOUR-BAR PRACTICE</span><h2 id="practice-title">Follow the chords. Play your own part.</h2><p class="practice-caption" id="practice-caption">Colored keys are silent hints. Only notes you play are recorded; the guide never adds accompaniment to MIDI or video.</p></div><a id="practice-edit" class="practice-edit" href="/tools/chord-progressions/">Edit in trainer ↗</a></div>
  <div id="practice-bars" class="practice-bars" role="group" aria-label="Selected practice bars"></div>
  <p id="practice-current" class="practice-current"></p>
  <div class="practice-transport">
    <div id="practice-pulse" class="practice-pulse" data-phase="idle" aria-label="Timed practice beat indicator">
      <output id="practice-count-number" class="practice-count-number" aria-live="off">READY</output>
      <div class="practice-pulse-middle">
        <span id="practice-pulse-caption" class="practice-pulse-caption">Four-beat count-in</span>
        <div class="practice-beat-dots" aria-hidden="true">
          <span class="practice-beat-dot"></span><span class="practice-beat-dot"></span><span class="practice-beat-dot"></span><span class="practice-beat-dot"></span>
        </div>
      </div>
    </div>
    <label class="practice-click-label"><input id="practice-clicks" type="checkbox" checked/> Soft beat clicks <small>(visual-only when off)</small></label>
    <button id="practice-count-cancel" class="practice-cancel" type="button" hidden>Cancel count-in</button>
  </div>
  <div class="learning-actions practice-actions">
    <button id="practice-prev" type="button">← Previous bar</button>
    <button id="practice-next" type="button">Next bar →</button>
    <button id="practice-start" class="action-primary" type="button">▶ Start timed guide</button>
    <button id="practice-stop" type="button">■ Stop guide</button>
    <button id="practice-record" class="action-primary" type="button">● Record & follow guide</button>
  </div>
  <p id="practice-status" class="learning-status" role="status" aria-live="polite">Play the highlighted chord on the piano below.</p>
  <section id="practice-report" class="practice-report" aria-labelledby="practice-report-title" hidden>
    <div class="practice-report-heading">
      <div><span class="eyebrow">YOUR RECORDING · LOCAL REVIEW</span><h3 id="practice-report-title">Your chord coverage</h3></div>
      <output id="practice-report-count" aria-label="Matched bars out of total">0 / 0</output>
    </div>
    <p id="practice-report-summary"></p>
    <ol id="practice-report-bars" class="practice-report-grid" aria-label="Recorded chord results by bar"></ol>
    <div class="learning-actions">
      <button id="practice-copy" type="button">Copy results for your post</button>
      <button id="practice-save" type="button">↓ Save practice summary</button>
    </div>
    <p id="practice-report-notice" class="learning-status" role="status" aria-live="polite"></p>
    <textarea id="practice-report-text" class="practice-copy-fallback" readonly hidden aria-label="Select and copy practice results"></textarea>
  </section>
 </div>
</section>
<section class="container section-compact"><div id="playable-piano" class="piano-shell"><header class="piano-head"><strong>VIRTUAL PIANO · A0–C8</strong><span id="vp-readout" role="status" aria-live="polite">Touch a piano key to begin</span></header>
<div id="vp-practice-hud" class="vp-practice-hud" hidden aria-label="Live piano practice controls">
  <div class="vp-practice-hud-chord"><span id="vp-practice-hud-label">FOUR-BAR PRACTICE</span><strong id="vp-practice-hud-title">Ready to practice</strong></div>
  <div id="vp-practice-pulse" class="practice-pulse" data-phase="idle" aria-label="Current practice beat">
    <output id="vp-practice-count-number" class="practice-count-number" aria-live="off">READY</output>
    <div class="practice-pulse-middle"><span id="vp-practice-pulse-caption" class="practice-pulse-caption">4/4 · 80 BPM</span><div class="practice-beat-dots" aria-hidden="true">
      <span class="practice-beat-dot"></span><span class="practice-beat-dot"></span><span class="practice-beat-dot"></span><span class="practice-beat-dot"></span>
    </div></div>
  </div>
  <div class="vp-practice-hud-actions"><button id="vp-practice-cancel" type="button" hidden>Cancel count-in</button><button id="vp-practice-stop-take" type="button" hidden>■ Stop &amp; review</button></div>
</div><div class="piano-controls"><span>Computer octave</span><button id="vp-down" type="button">−</button><output id="vp-oct">C4</output><button id="vp-up" type="button">+</button><button id="vp-sustain" type="button" aria-pressed="false">Sustain: Off</button><label>Volume <input id="vp-vol" type="range" min="0" max="100" value="55"/></label><button id="vp-stop" type="button">Stop</button></div><div class="piano-touch-toolbar" role="group" aria-label="Piano touch gesture mode">
  <strong>Finger gestures</strong>
  <button id="vp-touch-scroll" class="vp-touch-mode is-selected" type="button" aria-pressed="true">↔ Scroll keys</button>
  <button id="vp-touch-glide" class="vp-touch-mode" type="button" aria-pressed="false">♪ Glide to play</button>
  <span id="vp-touch-hint">Scroll mode: swipe to reach another octave. Tap several keys for chords.</span>
</div><nav class="piano-jumps" aria-label="Jump to a piano register"><button type="button" data-jump="36">Low C</button><button type="button" data-jump="60">Middle C</button><button type="button" data-jump="84">High C</button><span>Scroll horizontally to play all 88 keys →</span></nav><div id="vp-scroll" class="piano-scroller" data-touch-mode="scroll" tabindex="0" aria-label="Horizontal scrollable 88-key piano"><div class="piano-keybed" style="width:2184px">{keys.map(k=><button class:list={['piano-key',k.black?'black':'white']} type="button" style={'left:'+k.left+'px'} data-midi={k.midi} tabindex={k.midi===60?0:-1} aria-label={'Play '+k.note}><span>{k.note.startsWith('C')?k.note:''}</span></button>)}</div></div><div id="vp-chord-detect" class="piano-detection" data-kind="idle" role="status" aria-live="polite" aria-atomic="true"><span>LIVE CHORD RECOGNITION</span><strong id="vp-chord-name">Play a chord</strong><p id="vp-chord-notes">Hold three notes for a triad, or four different pitch classes for a seventh chord.</p></div><footer class="piano-foot">52 white · 36 black · Synthesized browser audio (not acoustic samples) · The separate metronome does not become part of the recorded performance.</footer></div></section>
<section class="container section-compact" id="piano-metronome"><MetronomePanel /></section>
<section class="container section-compact" id="recording-studio">
  <div id="vp-recording-studio" class="recording-shell">
    <div class="recording-heading">
      <div><span class="eyebrow">FREE · LOCAL-FIRST</span><h2>Record your melody. Share your moment.</h2><p>Capture what you play, listen back and create a vertical video with moving piano notes. Your performance stays on this device unless you choose to share a file.</p></div>
      <span class="recording-privacy">✓ No account or upload</span>
    </div>
    <div class="recording-fields">
      <label class="recording-title" for="vp-title">Your performance title
        <input id="vp-title" type="text" value="My Piano Session" maxlength="60" autocomplete="off" />
      </label>
      <label class="recording-title recording-theme" for="vp-theme">Video style<select id="vp-theme" aria-label="Video color theme"><option value="midnight">Midnight · purple</option><option value="aurora">Aurora · teal</option><option value="sunset">Sunset · coral</option></select></label>
      <output id="vp-clock" class="recording-time" aria-label="Performance elapsed time">00:00</output>
    </div>
    <div class="recording-actions" role="group" aria-label="Piano performance recording controls">
      <button id="vp-record" type="button" class="record-main">● Start recording</button>
      <button id="vp-end-record" type="button" class="record-danger" disabled>■ Stop recording</button>
      <button id="vp-replay" type="button" disabled>▶ Replay</button>
      <button id="vp-midi" type="button" disabled>↓ Save MIDI</button>
    </div>
    <div id="vp-message" class="recording-message" role="status" aria-live="polite">Ready to record, up to 90 seconds. Press Record, then play the piano above.</div>
    <div class="recording-stage">
      <h3>Make a TikTok / X / Shorts video</h3>
      <p>Create a 720 × 1280 (9:16) piano-roll video and audio in your browser. Rendering runs in real time; keep this tab open. No automatic social posting or platform authorization.</p>
      <label class="recording-caption-option"><input id="vp-show-chords" type="checkbox" checked /> Show detected chords and guided bar/beat targets in the video <small>(Targets and actually played chords are labelled separately.)</small></label>
      <div class="recording-actions">
        <button id="vp-export" type="button" class="record-main" disabled>🎬 Create 9:16 video</button>
        <button id="vp-cancel-export" type="button" class="record-danger" hidden>Cancel export</button>
      </div>
      <progress id="vp-progress" min="0" max="100" value="0" aria-label="Video rendering progress"></progress>
      <div class="recording-video-layout">
        <canvas id="vp-poster" width="720" height="1280" hidden aria-label="Preview of the animated 9 by 16 performance video"></canvas>
        <video id="vp-preview" controls playsinline preload="metadata" hidden aria-label="Preview of your generated piano performance video"></video>
        <div class="recording-video-side">
          <p id="vp-format" class="recording-muted">Native MP4 is preferred when supported; WebM videos can be converted locally.</p>
          <div class="recording-actions" role="group" aria-label="Optional on-device MP4 conversion">
            <button id="vp-convert-mp4" type="button" class="record-main" hidden disabled>Convert to MP4 on this device</button>
            <button id="vp-cancel-mp4" type="button" class="record-danger" hidden>Cancel conversion</button>
          </div>
          <p id="vp-mp4-info" class="recording-muted">Optional conversion downloads about 30 MB on first use; it stays on your device and can be memory-intensive.</p>
          <p class="recording-muted">Read <a href="/open-source/">open-source, codec and privacy notices</a>.</p>
          <div class="recording-actions"><button id="vp-download" type="button" disabled>↓ Download video</button><button id="vp-share" type="button" disabled>Share via device</button><button id="vp-download-webm" type="button" hidden disabled>↓ Download original WebM</button></div>
          <p class="recording-muted">If your phone doesn't support file sharing, download the video and upload it manually in TikTok, X or YouTube Shorts. You control the title, video and publication. No mandatory promotional watermark is added.</p>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="container section"><div class="tool-grid"><div class="panel"><h2>Play with computer keys</h2><p><strong>A W S E D F T G Y H U J K O L P ;</strong> map to the chromatic notes beginning at C4. Press <strong>Z/X</strong> to shift the octave and hold <strong>Space</strong> for sustain. Play several keys together for chords.</p><p>Shortcuts are inactive while typing in form fields. Focus an on-screen key and use the arrow keys to move, then Enter or Space to play it.</p></div><div class="panel"><h2>Play with touch or mouse</h2><p>Touch multiple keys at once to play a chord. <strong>Scroll keys</strong> lets you swipe horizontally through the 88-key range; <strong>Glide to play</strong> turns that swipe into a sequence of notes while keeping independent fingers on their own keys. Use Low, Middle or High C, or switch back to Scroll, to reach other registers.</p><p>This lightweight version uses synthesized tones so it does not need copyrighted piano recordings or a sample download.</p></div></div></section>
<script>
import {setupPianoRecorder} from '../../scripts/pianoRecorder.js';
import {setupProgressionGuide} from '../../scripts/progressionGuide.js';
import {describeHeldChord} from '../../lib/chordDetection.mjs';
const app=document.getElementById('playable-piano'),scroll=document.getElementById('vp-scroll'),readout=document.getElementById('vp-readout'),keys=new Map([...app.querySelectorAll('[data-midi]')].map(n=>[+n.dataset.midi,n]));
const codes={KeyA:0,KeyW:1,KeyS:2,KeyE:3,KeyD:4,KeyF:5,KeyT:6,KeyG:7,KeyY:8,KeyH:9,KeyU:10,KeyJ:11,KeyK:12,KeyO:13,KeyL:14,KeyP:15,Semicolon:16};
let octave=4,ctx=null,master=null,sustain=false,space=false;
let recorderHooks=null,practiceGuide=null;
const voices=new Map(),sources=new Map();
function updateChordDetection(){const chord=describeHeldChord([...voices.keys()]);const el=document.getElementById('vp-chord-detect');el.dataset.kind=chord.kind;document.getElementById('vp-chord-name').textContent=chord.title;document.getElementById('vp-chord-notes').textContent=chord.detail;}
function audio(){if(!ctx){const C=window.AudioContext||window.webkitAudioContext;if(!C){readout.textContent='Web Audio not supported';return false;}ctx=new C();master=ctx.createGain();master.gain.value=.25;master.connect(ctx.destination);}if(ctx.state==='suspended')ctx.resume().catch(()=>{});return true;}
function on(midi,source){if(midi<21||midi>108||sources.has(source))return;sources.set(source,midi);keys.get(midi)?.classList.add('pressed');if(voices.has(midi))return;if(!audio())return;
const t=ctx.currentTime,g=ctx.createGain();g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.16,t+.015);g.gain.exponentialRampToValueAtTime(.04,t+.6);g.gain.exponentialRampToValueAtTime(.015,t+2.7);g.connect(master);
const f=440*Math.pow(2,(midi-69)/12),os=[];for(const [v,type,level] of [[1,'triangle',1],[2,'sine',.18],[3,'sine',.05]]){const o=ctx.createOscillator(),a=ctx.createGain();o.type=type;o.frequency.value=f*v;a.gain.value=level;o.connect(a);a.connect(g);o.start();os.push(o);}voices.set(midi,{g,os});recorderHooks?.noteOn(midi);updateChordDetection();if(!source.startsWith('replay'))practiceGuide?.noteOn([...voices.keys()]);readout.textContent='Playing MIDI '+midi;
}
function release(midi){const v=voices.get(midi);if(!v||!ctx)return;voices.delete(midi);recorderHooks?.noteOff(midi);keys.get(midi)?.classList.remove('pressed');updateChordDetection();const t=ctx.currentTime;try{v.g.gain.cancelScheduledValues(t);v.g.gain.setValueAtTime(Math.max(.0001,v.g.gain.value),t);v.g.gain.exponentialRampToValueAtTime(.0001,t+.22);v.os.forEach(o=>o.stop(t+.3));}catch{}}
function off(source){const m=sources.get(source);if(m==null)return;sources.delete(source);if(![...sources.values()].includes(m)&&!(sustain||space))release(m);}
function drain(){if(sustain||space)return;for(const m of [...voices.keys()])if(![...sources.values()].includes(m))release(m);}
function stop(){sources.clear();for(const m of [...voices.keys()])release(m);readout.textContent='All notes released';}
function jump(m){const b=keys.get(m);if(b)scroll.scrollTo({left:Math.max(0,b.offsetLeft-scroll.clientWidth/2+22),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});}
const touchScroll=document.getElementById('vp-touch-scroll');
const touchGlide=document.getElementById('vp-touch-glide');
const touchHint=document.getElementById('vp-touch-hint');
function setTouchMode(mode){
  const glide=mode==='glide';
  // Switching while a finger is on a key must release captured voices first.
  stop();
  scroll.dataset.touchMode=glide?'glide':'scroll';
  touchScroll.classList.toggle('is-selected',!glide);
  touchGlide.classList.toggle('is-selected',glide);
  touchScroll.setAttribute('aria-pressed',String(!glide));
  touchGlide.setAttribute('aria-pressed',String(glide));
  touchHint.textContent=glide?'Glide mode: drag between keys to play; use octave jump buttons or switch back to Scroll to pan.':
    'Scroll mode: swipe to reach another octave. Tap several keys for chords.';
}
touchScroll.addEventListener('click',()=>setTouchMode('scroll'));
touchGlide.addEventListener('click',()=>setTouchMode('glide'));
for(const b of keys.values()){
  b.addEventListener('pointerdown',e=>{
    if(e.button!==0&&e.pointerType==='mouse')return;
    e.preventDefault();
    try{b.setPointerCapture(e.pointerId);}catch{ /* Some assistive pointer synthesizers do not support capture. */ }
    on(+b.dataset.midi,'p'+e.pointerId);
  });
  b.addEventListener('pointermove',e=>{
    if(scroll.dataset.touchMode!=='glide')return;
    const source='p'+e.pointerId;
    if(!sources.has(source))return;
    e.preventDefault();
    // Pointer capture keeps routing to the original key. Hit-test the
    // physical finger coordinates instead of trusting e.target.
    const hit=document.elementFromPoint(e.clientX,e.clientY)?.closest('.piano-key');
    const target=hit&&scroll.contains(hit)?+hit.dataset.midi:null;
    const previous=sources.get(source);
    if(target===previous)return;
    off(source);
    if(target!==null)on(target,source);
  });
  for(const name of ['pointerup','pointercancel','lostpointercapture'])
    b.addEventListener(name,e=>off('p'+e.pointerId));
}
// Fallback if capture is interrupted and the release targets another element.
// A second release is harmless because off() is idempotent.
for(const name of ['pointerup','pointercancel'])
  document.addEventListener(name,e=>off('p'+e.pointerId),true);

document.addEventListener('keydown',e=>{if(e.altKey||e.ctrlKey||e.metaKey||e.target.closest('input,textarea,select,a,button:not(.piano-key),[contenteditable]'))return;
const focus=e.target.closest('.piano-key');if(focus&&['ArrowLeft','ArrowRight'].includes(e.code)){e.preventDefault();const next=Math.max(21,Math.min(108,+focus.dataset.midi+(e.code==='ArrowRight'?1:-1)));focus.tabIndex=-1;keys.get(next).tabIndex=0;keys.get(next).focus();return;}
if(focus&&['Enter','Space'].includes(e.code)){e.preventDefault();if(!e.repeat)on(+focus.dataset.midi,'f'+focus.dataset.midi);return;}
if(e.code==='KeyZ'&&!e.repeat){e.preventDefault();setOctave(octave-1);return;}if(e.code==='KeyX'&&!e.repeat){e.preventDefault();setOctave(octave+1);return;}
if(e.code==='Space'){e.preventDefault();space=true;updateSustain();return;}
if(Object.hasOwn(codes,e.code)){e.preventDefault();if(!e.repeat)on(60+(octave-4)*12+codes[e.code],'k'+e.code);}
});
document.addEventListener('keyup',e=>{if(['Enter','Space'].includes(e.code)&&e.target.closest('.piano-key')){off('f'+e.target.dataset.midi);return;}if(e.code==='Space'){space=false;updateSustain();}off('k'+e.code);});
function setOctave(v){octave=Math.max(1,Math.min(7,v));document.getElementById('vp-oct').textContent='C'+octave;}
function updateSustain(){const b=document.getElementById('vp-sustain');b.textContent='Sustain: '+(sustain||space?'On':'Off');b.setAttribute('aria-pressed',String(sustain));drain();}
document.getElementById('vp-down').addEventListener('click',()=>setOctave(octave-1));document.getElementById('vp-up').addEventListener('click',()=>setOctave(octave+1));document.getElementById('vp-stop').addEventListener('click',stop);document.getElementById('vp-sustain').addEventListener('click',()=>{sustain=!sustain;updateSustain();});
document.getElementById('vp-vol').addEventListener('input',e=>{if(master)master.gain.value=e.target.value/100*.45;});app.querySelectorAll('[data-jump]').forEach(b=>b.addEventListener('click',()=>jump(+b.dataset.jump)));window.addEventListener('blur',()=>{space=false;stop();updateSustain();});window.addEventListener('pagehide',stop);requestAnimationFrame(()=>jump(60));
recorderHooks=setupPianoRecorder({on:midi=>on(midi,'replay'+midi),off:midi=>off('replay'+midi),stop,
  onCaptureStart:()=>practiceGuide?.recordingStart(),onCaptureEnd:take=>practiceGuide?.recordingEnd(take)});
practiceGuide=setupProgressionGuide({keys,scroll});
</script>
<style>
.piano-shell{background:#29263e;color:#f7f5ff;border-radius:23px;padding:24px;box-shadow:0 30px 65px -37px #211a40}.piano-head,.piano-foot{display:flex;justify-content:space-between;gap:15px;align-items:center;font-size:12px;color:#d2cbed}.piano-controls{display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:19px;background:#39334f;border-radius:14px;margin:24px 0}.piano-controls button,.piano-jumps button{background:#5c5284;color:white;border:0;border-radius:9px;padding:8px 13px}.piano-controls input{accent-color:#a494ff}.piano-controls output{min-width:34px;text-align:center}.piano-jumps{display:flex;flex-wrap:wrap;gap:9px;align-items:center;margin:15px 0}.piano-jumps span{font-size:11px;color:#d2cbed;margin-left:auto}.piano-scroller{overflow:auto hidden;border:6px solid #1a1728;border-radius:12px;scrollbar-color:#72688a #302b46}.piano-keybed{height:225px;position:relative;touch-action:pan-x}.piano-key{position:absolute;top:0;padding:0;touch-action:pan-x}.piano-key.white{width:42px;height:220px;background:linear-gradient(#fff,#edeaf5);border:1px solid #c9c5d5;border-bottom:5px solid #c8c2d1;border-radius:0 0 5px 5px;z-index:1}.piano-key.black{width:26px;height:135px;background:linear-gradient(100deg,#22202d,#39324e,#15131e);border:1px solid #17141c;border-bottom:5px solid black;border-radius:0 0 5px 5px;z-index:2;color:#ece8ff}.piano-key.pressed.white{background:#c6bcff}.piano-key.pressed.black{background:#8872ec}.piano-key span{position:absolute;bottom:9px;left:0;right:0;text-align:center;font-size:10px;font-weight:bold}.piano-foot{padding:17px 3px 0}.piano-shell .panel{color:#272539}@media(max-width:600px){.piano-shell{padding:12px}.piano-head{display:block}.piano-controls{padding:12px}.piano-jumps span{width:100%;margin:0}.piano-foot{display:block}}
.piano-detection{margin-top:15px;padding:14px 17px;background:#3b3458;border:1px solid #5e527f;border-radius:13px;display:grid;gap:5px;min-height:110px}.piano-detection span{font-size:10px;font-weight:800;letter-spacing:.12em;color:#cbbcff}.piano-detection strong{font-size:clamp(21px,3vw,29px);color:#fff}.piano-detection p{font-size:12px;line-height:1.5;color:#d9d0f1;margin:0}.piano-detection[data-kind="seventh"]{border-color:#76dac2;background:#23463e}.piano-detection[data-kind="seventh"] span{color:#a5f1dc}.piano-detection[data-kind="unknown"]{border-color:#eba7a0}
</style>
</BaseLayout>
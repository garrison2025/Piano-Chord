---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {releaseChords} from '../../data/chords.js';
import {createChord,prettyNote} from '../../lib/music.js';
const one=createChord(releaseChords[0]);const two=createChord(releaseChords[4]);
---
<BaseLayout title="Compare Piano Chords Side by Side | Piano Chord Explorer" description="Compare two piano chords by notes, shared tones and audio. Practice smooth chord transitions with a free side-by-side comparison tool." canonicalPath="/tools/chord-compare/" crumbs={[{name:'Chord Compare',href:'/tools/chord-compare/'}]}>
<div class="container page-hero"><span class="eyebrow">Free interactive tool</span><h1>Two chords.<br/>One clear difference.</h1><p class="lead">See which notes your chords share, which notes move, and how each harmony sounds. Build a smoother piano chord transition.</p></div>
<section class="container section-compact"><div class="tool-grid">
  <article class="panel compare-col"><label for="compare-a" class="input-label">First chord</label><select class="field" id="compare-a">{releaseChords.map(e=><option value={e.slug} selected={e.slug===one.slug}>{e.name}</option>)}</select><div id="compare-a-view" style="margin-top:18px"><h2>{one.name}</h2><p>{one.notes.map(prettyNote).join(' · ')}</p><img class="keyboard-image" src={`/diagrams/${one.slug}.svg`} alt={`${one.name} keyboard diagram`}/><button type="button" class="btn btn-primary" data-play-midi={one.inversions[0].midi.join(',')}>▶ Play A</button></div></article>
  <article class="panel compare-col"><label for="compare-b" class="input-label">Second chord</label><select class="field" id="compare-b">{releaseChords.map(e=><option value={e.slug} selected={e.slug===two.slug}>{e.name}</option>)}</select><div id="compare-b-view" style="margin-top:18px"><h2>{two.name}</h2><p>{two.notes.map(prettyNote).join(' · ')}</p><img class="keyboard-image" src={`/diagrams/${two.slug}.svg`} alt={`${two.name} keyboard diagram`}/><button type="button" class="btn btn-primary" data-play-midi={two.inversions[0].midi.join(',')}>▶ Play B</button></div></article>
</div><div id="compare-result" class="compare-result" aria-live="polite"><h3>Shared notes</h3><p>Pick two chords to compare their pitch classes and learn a simple note-moving exercise.</p></div></section>
</BaseLayout>

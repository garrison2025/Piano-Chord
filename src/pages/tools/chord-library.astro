---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {coreChords,qualities} from '../../lib/coreCatalog.js';
import {releaseChords} from '../../data/chords.js';
import {pitchClass} from '../../lib/music.js';
import {chordSearchFields} from '../../lib/chordSearch.mjs';
const atlasQuality={dominant7:'7',major7:'maj7',minor7:'m7'};
const links=new Map(releaseChords.map(v=>[v.root+':'+(atlasQuality[v.quality]||v.quality),'/chords/'+v.slug+'/']));
const lessonFor=c=>{
 const direct=links.get(c.root+':'+c.quality);
 if(direct)return {href:direct,label:'Lesson ↗'};
 if(!['major','minor'].includes(c.quality))return null;
 const other=releaseChords.find(e=>e.quality===c.quality&&pitchClass(e.root)===pitchClass(c.root));
 return other?{href:'/chords/'+other.slug+'/',label:'Enharmonic lesson ↗'}:null;
};
---
<BaseLayout title="120 Piano Chords – Interactive Chord Library" description="Explore and play 120 common piano chords, with correct note spelling. Learn major, minor, seventh, sus2, sus4 and diminished chords free." canonicalPath="/tools/chord-library/" crumbs={[{name:'120 Chords',href:'/tools/chord-library/'}]}>
<section class="container page-hero"><span class="eyebrow">THE INTERACTIVE CHORD ATLAS</span><h1>120 chords.<br/><em>One place to explore.</em></h1><p class="lead">Twelve roots, ten useful chord families. Every chord can be heard and searched instantly. Our 29 individually authored chord lessons include major, minor, dominant seventh, major seventh and minor seventh examples.</p><div class="button-row"><a class="btn btn-primary" href="/tools/virtual-piano/">Play the 88-key piano ↗</a><a class="btn" href="/chords/">Read chord lessons</a></div></section>
<section class="container section-compact">
<div class="panel"><div class="atlas-controls"><label>Find a chord<input id="atlas-search" class="field" type="search" placeholder="Cmaj7, C♯maj7, F# minor, sus4…" autocomplete="off"/></label><label>Chord family<select id="atlas-type" class="field"><option value="all">All ten families</option>{qualities.map(q=><option value={q.id}>{q.name}</option>)}</select></label><button class="btn" type="button" id="atlas-reset">Reset</button></div><p id="atlas-count" role="status" aria-live="polite">120 playable chords</p><p class="help-text">Sharp and flat root aliases are accepted. C♯maj7 finds D♭maj7, displayed using the library's own musical spelling.</p><div class="atlas-grid">{coreChords.map(c=><article class="atlas-card" data-quality={c.quality} data-search={chordSearchFields(c).canonical} data-alias={chordSearchFields(c).alias}><div><strong>{c.symbol}</strong><small>{c.name}</small><small class="atlas-alias-note" hidden>{chordSearchFields(c).equivalentLabel&&`Enharmonic search match: ${chordSearchFields(c).equivalentLabel} — shown as ${c.symbol}`}</small></div><p>{c.notes.map(n=>n.replaceAll('#','♯').replaceAll('b','♭')).join(' · ')}</p><div class="atlas-foot"><button type="button" class="btn btn-primary" data-play-midi={c.midi.join(',')} aria-label={'Hear '+c.name}>▶ Play</button><div class="atlas-links"><a href={'/tools/inversion-explorer/?root='+encodeURIComponent(c.root)+'&quality='+encodeURIComponent(c.quality)}>All inversions ↗</a>{lessonFor(c)&&<a href={lessonFor(c).href}>{lessonFor(c).label}</a>}</div></div></article>)}</div></div>
</section>
<section class="container section"><div class="panel"><h2>Why 120 chords?</h2><p>Open <a href="/tools/inversion-explorer/">the inversion explorer</a> from any card to hear all three or four voicings, or use the <a href="/tools/chord-finder/">chord finder</a> to identify a selected set of notes. These are twelve pitch-class roots multiplied by ten common formulas. Enharmonic spelling can depend on harmonic context; the displayed note names follow diatonic chord construction. Not every theoretical spelling has a separate page. This library links to 29 authored lessons; where an enharmonic root is used (for example, D♭ minor versus C♯ minor), the link is explicitly labelled and the note spelling may differ. Additional individual lessons are not automatically generated.</p></div></section>
<script>
import {explicitTriadQuality} from '../../lib/chordSearch.mjs';
const s=document.getElementById('atlas-search'),t=document.getElementById('atlas-type'),c=document.getElementById('atlas-count'),cards=[...document.querySelectorAll('.atlas-card')];
function norm(v){return String(v).toLowerCase().replaceAll('♯','#').replaceAll('♭','b').trim().replace(/\s+/g,' ');}
function render(){
  const q=norm(s.value),precise=explicitTriadQuality(q);let n=0;
  for(const e of cards){
    const direct=norm(e.dataset.search).includes(q);
    const viaAlias=!!q&&!direct&&norm(e.dataset.alias).includes(q);
    const ok=(t.value==='all'||e.dataset.quality===t.value)&&(!precise||e.dataset.quality===precise)&&(!q||direct||viaAlias);
    e.hidden=!ok;
    const note=e.querySelector('.atlas-alias-note');
    if(note)note.hidden=!ok||!viaAlias;
    if(ok)n++;
  }
  c.textContent='Showing '+n+' of '+cards.length+' playable chords';
}
s.addEventListener('input',render);t.addEventListener('change',render);document.getElementById('atlas-reset').addEventListener('click',()=>{s.value='';t.value='all';render();s.focus();});
</script>
<style>
.atlas-controls{display:grid;grid-template-columns:1fr 1fr auto;gap:18px;align-items:end}.atlas-controls label{font-size:12px;font-weight:750;color:#594fc2}.atlas-controls .field{margin-top:7px}.atlas-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.atlas-card{border:1px solid #e6e1ef;background:#faf9ff;padding:18px;border-radius:16px}.atlas-card[hidden]{display:none}.atlas-card strong{font-size:24px;color:#4941a4}.atlas-card small{display:block;font-size:11px;color:#7e7793}.atlas-card .atlas-alias-note{margin-top:6px;color:#4639ad;font-weight:650}.atlas-card .atlas-alias-note[hidden]{display:none}.atlas-card p{font-size:13px;margin:14px 0}.atlas-foot{border-top:1px solid #e9e4f2;padding-top:12px;display:flex;align-items:center;justify-content:space-between;gap:10px}.atlas-foot a{font-size:12px;color:#584ac7;font-weight:bold}.atlas-links{display:grid;gap:6px;text-align:right}.atlas-links a{white-space:nowrap}.atlas-foot span{font-size:11px;color:#9a94aa}.atlas-foot .btn{min-height:35px;padding:7px 13px;font-size:12px}
@media(max-width:700px){.atlas-foot{flex-wrap:wrap}.atlas-links{text-align:left;width:100%;gap:3px}.atlas-links a{white-space:normal}}@media(max-width:950px){.atlas-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.atlas-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.atlas-controls{grid-template-columns:1fr 1fr}.atlas-controls button{grid-column:1/-1}}@media(max-width:440px){.atlas-controls{grid-template-columns:1fr}.atlas-controls button{grid-column:auto}.atlas-card{padding:12px}}
</style>
</BaseLayout>
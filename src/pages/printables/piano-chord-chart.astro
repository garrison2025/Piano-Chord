---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {starterPrintableChords} from '../../data/chords.js';
import {createChord,prettyNote} from '../../lib/music.js';
---
<BaseLayout title="Free Printable Piano Chord Chart | 16 Core Chords" description="Print an original piano chord reference sheet with 16 major, minor and seventh chords, notes and accurate keyboard diagrams. A4 and US Letter friendly." canonicalPath="/printables/piano-chord-chart/" crumbs={[{name:'Printable Chord Chart',href:'/printables/piano-chord-chart/'}]}>
  <div class="container page-hero"><span class="eyebrow">Free printable resource</span><h1>A chord chart<br/>for your music stand.</h1><p class="lead">Print the original 16-chord starter selection with their notes and original keyboard diagrams. Use your browser's Print command to save as PDF or print to A4 / US Letter paper.</p><div class="button-row no-print"><button type="button" class="btn btn-primary" id="print-charts">↗ Print / Save as PDF</button><a class="btn" href="/chords/">Browse chord lessons</a></div></div>
  <section class="container section-compact"><div class="panel"><div class="section-head no-print"><div><h2>16-chord reference</h2><p>Each diagram covers a reference keyboard range, with its notes written beside it.</p></div></div><div class="print-sheet">
  {starterPrintableChords.map(entry=>{const c=createChord(entry);return <article class="print-cell"><strong>{prettyNote(c.symbol)} · {c.qualityName}</strong><span>{c.notes.map(prettyNote).join(' – ')}</span><img src={`/diagrams/${entry.slug}.svg`} alt={`${c.name}: ${c.notes.map(prettyNote).join(', ')}`} width="692" height="195" loading="lazy" /></article>})}
</div></div><p class="print-note">Print uses the paper size selected in your browser dialog. For physical accuracy, review printer scale settings; fit-to-page can resize diagrams.</p></section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PianoKeyboard from '../../components/PianoKeyboard.astro';
import {releaseChords} from '../../data/chords.js';
import {createChord,prettyNote} from '../../lib/music.js';
const bySlug=slug=>createChord(releaseChords.find(e=>e.slug===slug));
const c7=bySlug('c-7'),cmaj7=bySlug('c-major-7'),am7=bySlug('a-minor-7'),dm7=bySlug('d-minor-7'),g7=bySlug('g-7');
const family=[
 {chord:c7,interval:'1 – 3 – 5 – ♭7',meaning:'Major third + minor seventh',note:'B♭ is 10 semitones above C. The plain 7 symbol does not mean major seventh.'},
 {chord:cmaj7,interval:'1 – 3 – 5 – 7',meaning:'Major third + major seventh',note:'B natural is 11 semitones above C. Only the seventh changes compared with C7.'},
 {chord:am7,interval:'1 – ♭3 – 5 – ♭7',meaning:'Minor third + minor seventh',note:'Am7 has C natural, not C♯; and G natural, not G♯.'}
];
const cadence=[dm7,g7,cmaj7];
const cycle=[cmaj7,am7,dm7,g7];
---
<BaseLayout title="Piano Seventh Chords: C7 vs Cmaj7 vs Am7 – Notes & Audio" description="Hear the difference between dominant, major and minor seventh piano chords. Compare C7, Cmaj7 and Am7, then practice Dm7–G7–Cmaj7 with original keyboard diagrams." canonicalPath="/guides/seventh-chords-piano/" crumbs={[{name:'Chord lessons',href:'/chords/'},{name:'Seventh chords',href:'/guides/seventh-chords-piano/'}]}>
<section class="container page-hero">
 <span class="eyebrow">THE HARMONY LAB / SEVENTH CHORDS</span>
 <h1>One extra note.<br/><em>Three different sounds.</em></h1>
 <p class="lead">A plain 7, a maj7 and an m7 do not mean the same thing. Compare exact note spellings, hear each chord, and practice a four-chord progression entirely in your browser.</p>
 <div class="button-row"><a class="btn btn-primary" href="#listen">Compare the sounds ↓</a><a class="btn" href="#cadence">Practice ii–V–I ↓</a></div>
</section>
<section class="container section-compact" id="listen"><div class="section-head"><div><span class="eyebrow">01 / HEAR THE QUALITY</span><h2>Compare the seventh and the third</h2><p>C7 and Cmaj7 share the first three notes; Am7 changes both the root and the third. Listen to each before reading the names.</p></div></div>
 <div class="card-grid">
 {family.map(({chord,interval,meaning,note})=><article class="panel seventh-card">
    <span class="eyebrow">{chord.qualityName}</span><h3><a href={'/chords/'+chord.slug+'/'}>{prettyNote(chord.symbol)}</a></h3>
    <p><strong>{chord.notes.map(prettyNote).join(' · ')}</strong></p>
    <p class="seventh-interval">{interval}</p>
    <PianoKeyboard chord={chord}/>
    <p><strong>{meaning}.</strong> {note}</p>
    <div class="button-row"><button type="button" class="btn btn-primary" data-play-midi={chord.inversions[0].midi.join(',')}>▶ Hear {prettyNote(chord.symbol)}</button><a class="btn" href={'/chords/'+chord.slug+'/'}>All inversions ↗</a></div>
  </article>)}
 </div>
</section>
<section class="container section-compact"><div class="two-col">
 <article class="panel"><span class="eyebrow">02 / THE HALF-STEP TEST</span><h2>C7 versus Cmaj7</h2><p>Hold C, E and G. Play B♭ to hear C7, then move just that top note up one semitone to B natural to hear Cmaj7. The root, third and fifth never change.</p><p>C7 is often used as a dominant resolving toward F; Cmaj7 can serve as the tonic seventh chord in C major. The names describe different intervals, not interchangeable spellings.</p><div class="button-row"><button class="btn" type="button" data-play-midi={c7.inversions[0].midi.join(',')}>▶ C7</button><button class="btn" type="button" data-play-midi={cmaj7.inversions[0].midi.join(',')}>▶ Cmaj7</button></div></article>
 <article class="panel"><span class="eyebrow">03 / THE MINOR THIRD</span><h2>Am7 versus A7</h2><p>Am7 spells A–C–E–G, so both the third and the seventh are minor. A7 would instead spell A–C♯–E–G. Changing only C to C♯ changes the chord quality even though the root and seventh stay fixed.</p><p>Play Am7 with all white keys, then compare its close relative Cmaj7. The two chords share C, E and G, but they do not have the same root.</p><div class="button-row"><button class="btn" type="button" data-play-midi={am7.inversions[0].midi.join(',')}>▶ Am7</button><a class="btn" href="/chords/a-minor-7/">Am7 lesson ↗</a></div></article>
 </div>
</section>
<section id="cadence" class="container section-compact">
 <div class="section-head"><div><span class="eyebrow">04 / MAKE IT MUSICAL</span><h2>The ii–V–I in C major</h2><p>Play Dm7, G7 and Cmaj7 in order, holding each chord for four metronome beats at 60–80 BPM. In a simple close voicing, notice how F in G7 tends toward E in Cmaj7.</p></div><a class="text-link" href="/tools/metronome/">Open metronome ↗</a></div>
 <div class="card-grid">
  {cadence.map((chord,i)=><article class="panel seventh-step">
   <span class="eyebrow">{['ii7','V7','Imaj7'][i]} · bar {i+1}</span><h3>{prettyNote(chord.symbol)}</h3><p>{chord.notes.map(prettyNote).join(' · ')}</p>
   <button class="btn btn-primary" type="button" data-play-midi={chord.inversions[0].midi.join(',')}>▶ Play bar {i+1}</button>
   <a class="text-link" href={'/chords/'+chord.slug+'/'}>Read lesson ↗</a>
  </article>)}
 </div>
 <div class="panel seventh-player" id="seventh-player" aria-labelledby="seventh-player-title">
  <div class="seventh-player-heading">
    <div><span class="eyebrow">PLAY THE FULL SEQUENCE</span><h3 id="seventh-player-title">Practice the changes in time.</h3><p>Each chord plays for one four-beat bar. Follow the highlighted bar, repeat the cycle or stop at any point. All sound is synthesized on your device.</p></div>
  </div>
  <div class="seventh-player-controls">
   <label for="seventh-pattern">Choose a progression
    <select id="seventh-pattern"><option value="ii-v-i">ii–V–I in C</option><option value="turnaround">I–vi–ii–V turnaround</option></select>
   </label>
   <label for="seventh-tempo">Tempo
    <input id="seventh-tempo" type="range" min="50" max="180" step="1" value="80" aria-label="Seventh progression beats per minute"/>
   </label>
   <output id="seventh-tempo-output" for="seventh-tempo">80 BPM</output>
  </div>
  <div class="seventh-player-toggles">
    <label><input type="checkbox" id="seventh-click" checked/> Four-beat metronome click</label>
    <label><input type="checkbox" id="seventh-loop"/> Loop until stopped</label>
  </div>
  <div class="seventh-play-grid" id="seventh-player-bars" role="list" aria-label="Chord bars in playback sequence">
   {cadence.map((chord,i)=><div class="seventh-play-bar" role="listitem" data-bar={i} aria-current="false"><small>BAR {i+1}</small><strong>{prettyNote(chord.symbol)}</strong><span>{chord.notes.map(prettyNote).join(' · ')}</span></div>)}
  </div>
  <div class="button-row">
   <button type="button" id="seventh-start" class="btn btn-primary">▶ Play progression</button>
   <button type="button" id="seventh-stop" class="btn" disabled>■ Stop</button>
  </div>
  <p id="seventh-player-status" class="seventh-player-status" role="status" aria-live="polite">Select a tempo and press Play. Four beats per chord in 4/4.</p>
  <p class="help-text">This is an audible practice guide. It does not capture, upload or automatically record your playing. For recording, use the <a href="/tools/virtual-piano/">88-key virtual piano</a>.</p>
 </div>
 <div class="panel" style="margin-top:18px"><h3>Now try a four-bar turnaround</h3><p>In C major, one possible Imaj7–vi7–ii7–V7 cycle is Cmaj7 – Am7 – Dm7 – G7. Listen for common tones before repeating. Use the practice player above for timed playback, or audition each chord separately below.</p>
 <div class="button-row">
 {cycle.map(chord=><button class="btn" type="button" data-play-midi={chord.inversions[0].midi.join(',')}>▶ {prettyNote(chord.symbol)}</button>)}
 </div><p class="help-text">All audio uses local synthesized browser sound; no account, music samples or recording upload.</p></div>
</section>
<section class="container section-compact"><div class="panel"><h2>Where to go next</h2><p>For exact note positions and four complete voicings, open the individual lessons. For chord recognition without knowing the symbol, try the free chord finder.</p><div class="button-row"><a class="btn btn-primary" href="/chords/">Browse all 29 lessons ↗</a><a class="btn" href="/tools/chord-finder/">Identify piano chords ↗</a><a class="btn" href="/tools/chord-progressions/">Build a four-bar progression ↗</a></div></div></section>
<script>
import {setupSeventhPractice} from '../../scripts/seventhPracticePlayer.js';
setupSeventhPractice();
</script>
<style>
.seventh-player{margin-top:19px;padding:clamp(18px,3vw,28px);background:linear-gradient(128deg,#fcfbff,#f4f0ff)}
.seventh-player-heading h3{font-size:clamp(23px,3vw,31px);margin:8px 0}
.seventh-player-heading p{max-width:720px;margin:0 0 20px;font-size:14px}
.seventh-player-controls{display:grid;grid-template-columns:minmax(200px,2fr) minmax(160px,1fr) auto;gap:16px;align-items:end}
.seventh-player-controls label{display:flex;flex-direction:column;gap:7px;color:#61548d;font-weight:750;font-size:13px}
.seventh-player-controls select{background:#fff;border:1px solid #cbc4e4;border-radius:12px;min-height:46px;padding:8px 12px;color:#3d3566;max-width:100%}
.seventh-player-controls input[type="range"]{accent-color:#6657cb;min-height:46px;width:100%;cursor:pointer}
.seventh-player-controls output{font-size:20px;color:#4d42a2;font-weight:800;white-space:nowrap;padding-bottom:7px}
.seventh-player-toggles{display:flex;gap:20px;flex-wrap:wrap;margin:16px 0;color:#62578e;font-size:13px}
.seventh-player-toggles label{display:flex;gap:8px;align-items:center}
.seventh-player-toggles input{accent-color:#6657cb;width:18px;height:18px}
.seventh-play-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px;margin:17px 0}
:global(#seventh-player-bars .seventh-play-bar){min-width:0;border:1px solid #dfd7f6;border-radius:15px;background:#fff;padding:15px;display:flex;flex-direction:column;gap:5px;transition:border-color .12s,background .12s,transform .12s}
:global(#seventh-player-bars .seventh-play-bar small){font-size:11px;font-weight:800;color:#8e83ae}
:global(#seventh-player-bars .seventh-play-bar strong){font-size:clamp(22px,2.4vw,30px);color:#4f43a1}
:global(#seventh-player-bars .seventh-play-bar span){font-size:12px;color:#756b97;overflow-wrap:anywhere}
:global(#seventh-player-bars .seventh-play-bar.is-current){background:#e6e1ff;border-color:#7061da;box-shadow:0 8px 20px -13px #41318d;transform:translateY(-2px)}
.seventh-player-status{font-size:14px;color:#4b4183;min-height:24px}
.seventh-player .help-text{font-size:12px;color:#776d94;margin:5px 0}
.seventh-player .help-text a{color:#4f3ec3;text-decoration:underline}
@media(max-width:850px){.seventh-player-controls{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.seventh-player-controls output{grid-column:1/-1}}
@media(max-width:600px){.seventh-player-controls{grid-template-columns:minmax(0,1fr)}.seventh-player-controls output{grid-column:auto}.seventh-play-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.seventh-player .button-row{display:flex;flex-wrap:wrap}.seventh-player .button-row button{flex:1 1 120px}}
@media(prefers-reduced-motion:reduce){:global(#seventh-player-bars .seventh-play-bar){transition:none}:global(#seventh-player-bars .seventh-play-bar.is-current){transform:none}}
.seventh-card,.seventh-step{min-width:0;overflow:hidden}
#listen .card-grid,#cadence .card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
@media(max-width:920px){#listen .card-grid,#cadence .card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){#listen .card-grid,#cadence .card-grid{grid-template-columns:minmax(0,1fr)}}
.seventh-card h3{font-size:clamp(27px,3vw,40px);margin:.25em 0}
.seventh-card .keyboard-frame{width:100%;max-width:100%;overflow:hidden}
.seventh-card .keyboard-frame :global(svg){max-width:100%;height:auto}
.seventh-card p{font-size:14px;line-height:1.65}
.seventh-card .button-row,.seventh-step{display:flex;flex-direction:column;gap:12px;align-items:stretch}
.seventh-card .button-row{align-items:start;flex-direction:row;flex-wrap:wrap}
.seventh-interval{color:#4d40ad;font-weight:800;letter-spacing:.03em}
.seventh-step h3{margin:0;font-size:clamp(26px,3vw,37px)}
.seventh-step p{flex:1}
.seventh-step button{align-self:start}
@media(max-width:700px){.seventh-card .button-row{flex-direction:column;align-items:stretch}.seventh-card .btn{white-space:normal}}
</style>
</BaseLayout>

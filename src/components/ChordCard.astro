---
import {createChord,prettyNote} from '../lib/music.js';
const {entry,small=false}=Astro.props;
const chord=createChord(entry);
---
<a class:list={['chord-card',small && 'chord-card-small',`chord-${entry.quality}`]} href={`/chords/${entry.slug}/`}>
  <span class="chord-card-top"><span class="chord-symbol">{chord.symbol.replaceAll('b','♭')}</span><span class="mini-arrow" aria-hidden="true">↗</span></span>
  <span class="chord-subtitle">{chord.name}</span>
  <span class="note-row" aria-label={`Notes: ${chord.notes.map(prettyNote).join(', ')}`}>{chord.notes.map(n=><span class="note-pill">{prettyNote(n)}</span>)}</span>
  <span class="card-bottom">Explore this chord <span aria-hidden="true">↗</span></span>
</a>
